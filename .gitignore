# Ambiente e credenciais
.env
.env.*
# ...menos o modelo sem valores reais, que precisa ser versionado para que o
# ambiente suba a partir do que esta no repositorio (criterio da E07).
!.env.exemplo
*.key
*.pem
credenciais*
senha*

# Contexto e configuracao do Claude Code (permanece local)
CLAUDE.md
CLAUDE.local.md
.claude/

# Dados gerados (versiona-se o script, nao a saida)
dados/sinteticos/*
!dados/sinteticos/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Sistema
.DS_Store
Thumbs.db
desktop.ini

# Editores
.vscode/
.idea/

# Temporarios de escritorio
~$*
