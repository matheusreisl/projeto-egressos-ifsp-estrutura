    <id><![CDATA[720]]></id>
    <qid><![CDATA[720]]></qid>
    <question><![CDATA[<p><strong>[CONV]</strong> versão do termo — metadado do consentimento, calculado pela plataforma e oculto (E22)</p>]]></question>
